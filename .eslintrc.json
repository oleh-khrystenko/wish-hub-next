{
    "extends": ["next/core-web-vitals", "plugin:prettier/recommended"],
    "plugins": ["prettier", "tailwindcss"],
    "rules": {
        "prettier/prettier": ["error"],
        "tailwindcss/classnames-order": "warn",
        "max-len": [
            "error",
            {
                "code": 120,
                "ignoreUrls": true,
                "ignoreStrings": true,
                "ignoreTemplateLiterals": true
            }
        ]
    }
}
